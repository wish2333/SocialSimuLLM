# SocialSimuLLM Environment Configuration
# Copy this file to .env and fill in your values.
# Values here override system environment variables; CLI args take highest priority.
#
# Priority: CLI args > .env > system environment variables > defaults

# --- LLM API ---
# Required. Your OpenAI (or compatible) API key.
OPENAI_API_KEY=

# Base URL for OpenAI-compatible API.
OPENAI_BASE_URL=https://api.deepseek.com/v1

# --- Models ---
# Completion model for agent planning, action, and reflection.
# Supports DeepSeek V4 role-play thinking mode (auto-injected).
OPENAI_MODEL=deepseek-v4-flash

# --- Embedding API (separate from LLM API) ---
# Embedding model name.
OPENAI_EMBEDDING_MODEL=BAAI/bge-m3

# Separate base URL and API key for embedding service.
# Leave empty to fall back to the LLM API config above.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Optional ---
# Identifier for the API key owner (logged in experiment metadata).
SOCIALSIMU_KEY_OWNER=
